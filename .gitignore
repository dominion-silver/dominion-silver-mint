# Written by the reproducible-build job and by anyone exercising that step locally. It
# is a MEASUREMENT of one build, never a source of truth: the pin lives in
# config/mainnet-authorities.json and is copied there deliberately, once, per candidate.
release-manifest.json
# Emitted by the ceremony builders: the exact instructions for the Ops Squads.
# Kept OUT of the repo because it is per-ceremony and per-cluster, and a committed copy would be
# read as the canonical one long after the ceremony it came from.
ceremony-out/

# A tracked .pyc puts an opaque binary in the release verifier trust path.
__pycache__/
*.pyc

# Monitor alert memory (scripts/_alert-state.ts). Restored by actions/cache, never committed: it is
# per-environment runtime state, and a committed copy would be stale on every run.
.monitor-state/
