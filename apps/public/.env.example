# A PAID RPC IS REQUIRED IN PRODUCTION, not a preference. api.mainnet-beta.solana.com
# rate-limits per method: the public devnet endpoint returned 429 on getTransactions during the
# operational work, and a public mainnet endpoint will throttle real users on the price
# banner and the mint/redeem flow. Set at least one of these; the app falls back between them.
NEXT_PUBLIC_HELIUS_RPC=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
NEXT_PUBLIC_TRITON_RPC=https://rpc.triton.one/?api-key=YOUR_KEY

# Pyth Lazer (Pyth Pro). SERVER-ONLY: no NEXT_PUBLIC_ prefix, or the key ships to the browser.
# Read by src/app/api/lazer/route.ts, which is the ONLY path to a signed price envelope, so
# without it mint and redeem cannot be priced at all.
#
# THE KEY NEEDS THE `pyth-indices` FEED GROUP FOR FEED 3154 (Metal.Index.SILVER/USD), which is
# what config/mainnet-authorities.json pins. Earlier notes in this repo said 3304; that was the
# previous feed and asking the provider to entitle 3304 would leave SILV returning 403.
#
# This variable was MISSING from this file until 2026-08-11, while being required for the app to
# function. Anyone provisioning a fresh Vercel project from this template would have shipped an
# app whose price route 403s.
PYTH_LAZER_API_KEY=your-pyth-lazer-key
