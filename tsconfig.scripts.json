{
  "//": [
    "Typechecks scripts/ with the same compiler the CI gate uses.",
    "Run: npx tsc --noEmit -p tsconfig.scripts.json"
  ],
  "compilerOptions": {
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowJs": false,
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "types": [
      "node"
    ],
    "baseUrl": "."
  },
  "include": [
    "scripts/**/*.ts"
  ]
}
